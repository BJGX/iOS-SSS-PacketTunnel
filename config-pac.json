{
  "log": { "level": "debug" },

  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 10808,
      "sniff": true
    }
  ],

  "outbounds": [
      {
        "type": "socks",
        "tag": "overtls-proxy",
        "server": "127.0.0.1",
        "server_port": 40000
      },
      {
        "type": "direct",
        "tag": "direct-safe"
      },
      {
        "type": "dns",
        "tag": "dns-out"
      }
    ],

    "dns": {
      "servers": [
        { "address": "223.5.5.5", "detour": "direct-safe" },
        { "address": "8.8.8.8", "detour": "overtls-proxy" }
      ],
      "strategy": "ipv4_only"
    },

    "route": {
      "final": "overtls-proxy",
      "rules": [
        { "protocol": "dns", "outbound": "dns-out" },

        {
          "rule_set": "geosite-cn",
          "outbound": "direct-safe"
        },
        {
          "rule_set": "geoip-cn",
          "outbound": "direct-safe"
        },

        {
          "rule_set": "geosite-gfw",
          "outbound": "overtls-proxy"
        },

        { "outbound": "overtls-proxy" }
      ],

      "rule_set": [
        {
          "tag": "geosite-cn",
          "type": "local",
          "format": "binary",
          "path": "geosite-cn.srs"
        },
        {
          "tag": "geoip-cn",
          "type": "local",
          "format": "binary",
          "path": "geoip-cn.srs"
        },
        {
          "tag": "geosite-gfw",
          "type": "local",
          "format": "binary",
          "path": "gfw.srs"
        }
      ]
    }
}
